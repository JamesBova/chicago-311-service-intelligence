{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunChicago311Task",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:aws:ecs:us-east-2:690260957255:task-definition/chicago311-ingestion-dev:1",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws:ecs:us-east-2:690260957255:cluster/chicago311-dev"
        }
      }
    },
    {
      "Sid": "PassChicago311TaskRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::690260957255:role/chicago311-ecs-execution-role",
        "arn:aws:iam::690260957255:role/chicago311-ecs-task-role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    }
  ]
}
