{
  "Name": "chicago311-ingestion-daily",
  "GroupName": "default",
  "Description": "Daily Chicago 311 ingestion at 6 AM Central",
  "ScheduleExpression": "cron(0 6 * * ? *)",
  "ScheduleExpressionTimezone": "America/Chicago",
  "FlexibleTimeWindow": {
    "Mode": "OFF"
  },
  "State": "ENABLED",
  "Target": {
    "Arn": "arn:aws:ecs:us-east-2:690260957255:cluster/chicago311-dev",
    "RoleArn": "arn:aws:iam::690260957255:role/chicago311-scheduler-role",
    "EcsParameters": {
      "TaskDefinitionArn": "arn:aws:ecs:us-east-2:690260957255:task-definition/chicago311-ingestion-dev:1",
      "LaunchType": "FARGATE",
      "PlatformVersion": "LATEST",
      "TaskCount": 1,
      "NetworkConfiguration": {
        "awsvpcConfiguration": {
          "Subnets": [
            "subnet-00b6cf39b2ebb5a26",
            "subnet-0a936b218f433e179",
            "subnet-00c2489a7093c9352"
          ],
          "SecurityGroups": [
            "sg-020db663facf76ea6"
          ],
          "AssignPublicIp": "ENABLED"
        }
      }
    },
    "RetryPolicy": {
      "MaximumRetryAttempts": 2,
      "MaximumEventAgeInSeconds": 3600
    }
  }
}
